rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helpers ─────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isStaff() {
      // role custom claim: 'admin' o 'vendedor'
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'vendedor'
      );
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    // Carpeta `config/` ────────────────────────────────────
    // El logo se renderiza en /login (sin sesión) y en tirillas impresas,
    // así que la LECTURA queda pública. La ESCRITURA queda restringida a admin.
    match /config/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Todo lo demás ────────────────────────────────────────
    // Lectura y escritura: solo personal interno autenticado.
    // (Antes: lectura pública sin restricción + escritura por cualquier autenticado.)
    match /{allPaths=**} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
  }
}
