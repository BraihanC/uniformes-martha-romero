rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function hasRole(r) {
      return isSignedIn() && request.auth.token.role == r;
    }
    function isAdmin() { return hasRole('admin'); }
    function isVendedor() { return hasRole('vendedor'); }
    function isStaff() { return isAdmin() || isVendedor(); }

    // ─── Configuración pública ──────────────────────────────
    // El logo de la empresa se renderiza en /login (sin sesión).
    // Subcolecciones sensibles bajo /config deben heredar via match anidado si las hubiera.
    match /config/{docId} {
      allow read: if true;          // logo público
      allow write: if isAdmin();
    }

    // ─── Catálogo (B2B portal + staff) ──────────────────────
    // Productos / colegios / precios corporativos: cualquier usuario autenticado
    // puede LEER (catálogo del portal). Solo staff escribe.
    match /products/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /colegios/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /precios_corporativos/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // ─── Identidad de clientes corporativos ─────────────────
    // El AuthContext (esClienteCorporativo) lee esta colección al login para
    // decidir si el usuario va al portal o a la app principal. Por eso lectura
    // queda abierta a autenticados. Solo admin escribe.
    //
    // Phase 2 (recomendado): keyear los docs por uid y exponer solo el doc
    // propio: `allow read: if isSignedIn() && (isStaff() || resource.id == request.auth.uid)`
    match /clientes_corporativos/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Pedidos B2B (portal) ───────────────────────────────
    // - create: staff, o el cliente creando un pedido A SU NOMBRE (el
    //   clienteEmail del doc debe ser el del token — evita crear pedidos
    //   a nombre de otro cliente).
    // - read: staff total, o el cliente dueño (matcheado por clienteEmail).
    //   Pedidos legacy sin clienteEmail solo son legibles por staff (esperado tras backfill).
    // - update: staff, o el cliente dueño SOLO para confirmar recepción de
    //   mercancía (MisPedidos.jsx toca exactamente productos/estado/updatedAt).
    // - delete: solo staff.
    match /pedidos_b2b/{id} {
      allow create: if isStaff() ||
        (isSignedIn() && request.resource.data.clienteEmail == request.auth.token.email);
      allow read: if isStaff() ||
        (isSignedIn() && resource.data.clienteEmail == request.auth.token.email);
      allow update: if isStaff() ||
        (isSignedIn() &&
         resource.data.clienteEmail == request.auth.token.email &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['productos', 'estado', 'updatedAt']));
      allow delete: if isStaff();
    }

    // ─── Notificaciones ─────────────────────────────────────
    // notificaciones_admin: B2B las crea al hacer pedido, staff las lee.
    match /notificaciones_admin/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isStaff();
    }
    // notificaciones_portal: staff las crea, B2B las lee (filtro por uid en cliente)
    // y las marca como leídas (NotificacionesContext toca solo leida/fechaLeida).
    // Phase 2: campo `clienteUid` para restringir por dueño en rules.
    match /notificaciones_portal/{id} {
      allow create: if isStaff();
      allow read: if isSignedIn();
      allow update: if isStaff() ||
        (isSignedIn() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['leida', 'fechaLeida']));
      allow delete: if isStaff();
    }

    // ─── Reportes de imperfectos (portal) ───────────────────
    // B2B reporta, staff gestiona. B2B también lee sus propios reportes
    // (filtrado por clienteEmail). Update/delete sigue siendo solo staff.
    match /reportes_imperfectos/{id} {
      allow create: if isSignedIn();
      allow read: if isStaff() ||
        (isSignedIn() && resource.data.clienteEmail == request.auth.token.email);
      allow update, delete: if isStaff();
    }

    // ─── Consecutivo de pedidos B2B ─────────────────────────
    // El portal (cliente autenticado, sin rol staff) reserva su numeroPedido
    // vía transacción sobre este doc. Solo se le permite el incremento EXACTO
    // de +1 sobre lastNumber — cualquier otro valor o campo extra se rechaza.
    // El doc lo siembra un admin (create/delete siguen siendo staff-only vía
    // el match genérico de /counters/{id} más abajo).
    match /counters/pedidos_b2b {
      allow read: if isSignedIn();
      // diff().affectedKeys() en vez de keys().hasOnly(): valida los campos
      // TOCADOS por el write, no el doc final — así un campo extra sembrado
      // por un admin en el doc no bloquea los incrementos del portal.
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastNumber']) &&
        request.resource.data.lastNumber is int &&
        request.resource.data.lastNumber == resource.data.lastNumber + 1;
    }

    // ─── Resto: solo staff (operación interna) ──────────────
    // Datos sensibles: ventas, finanzas, clientes, inventario, stock.
    // Antes: cualquier autenticado podía leer y escribir TODO.
    match /apartados/{id}              { allow read, write: if isStaff(); }
    match /bases_caja/{id}             { allow read, write: if isStaff(); }
    match /cambiosYDevoluciones/{id}   { allow read, write: if isStaff(); }
    match /clientes/{id}               { allow read, write: if isStaff(); }
    match /clients/{id}                { allow read, write: if isStaff(); }
    match /counters/{id}               { allow read, write: if isStaff(); }
    match /pedidos/{id}                { allow read, write: if isStaff(); }
    match /productosReparacion/{id}    { allow read, write: if isStaff(); }
    match /proveedores/{id}            { allow read, write: if isStaff(); }
    match /sales/{id}                  { allow read, write: if isStaff(); }
    match /satelites/{id}              { allow read, write: if isStaff(); }
    match /stockEntries/{id}           { allow read, write: if isStaff(); }
    match /transactions/{id}           { allow read, write: if isStaff(); }
    match /transactions_b2b/{id}       { allow read, write: if isStaff(); }

    // ─── Default deny ───────────────────────────────────────
    // Cualquier colección NO listada arriba queda bloqueada por defecto.
    // Si se añade una nueva colección, hay que decidir explícitamente sus reglas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
